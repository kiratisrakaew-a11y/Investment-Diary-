# Postgres connection string (Neon / Vercel Postgres / local)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/diary
# Password for logging into the web UI
APP_PASSWORD=change-me
# Secret used to sign the session cookie (any long random string)
SESSION_SECRET=replace-with-a-long-random-string
# Bearer key used by Claude (MCP) and ChatGPT (Actions) to call the API
API_KEY=replace-with-a-long-random-key
# Optional: SEC Thailand Open API subscription key for Thai mutual fund NAVs
SEC_API_KEY=
# Optional: secret Vercel Cron sends as Bearer token to /api/cron/prices
CRON_SECRET=
# Optional: Claude API key for the in-app AI advisor (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional: advisor effort — low | medium | high
ADVISOR_EFFORT=medium
